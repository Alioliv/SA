{
  "name": "loja-api",
  "version": "1.0.0",
  "description": "API REST - Loja de Roupas com PostgreSQL (sem ORM)",
  "main": "serve.js",
  "scripts": {
    "start": "node serve.js",
    "dev": "nodemon serve.js",
    "setup-db": "node src/config/setupDb.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
